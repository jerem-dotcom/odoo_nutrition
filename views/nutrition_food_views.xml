<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_nutrition_food_list" model="ir.ui.view">
        <field name="name">nutrition.food.list</field>
        <field name="model">nutrition.food</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="brand"/>
                <field name="barcode"/>
                <field name="energy_kcal"/>
                <field name="proteins"/>
                <field name="carbohydrates"/>
                <field name="fat"/>
                <field name="nutriscore_grade"/>
                <field name="nova_group"/>
            </list>
        </field>
    </record>

    <record id="view_nutrition_food_form" model="ir.ui.view">
        <field name="name">nutrition.food.form</field>
        <field name="model">nutrition.food</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_refresh_off" type="object"
                            string="Synchroniser OpenFoodFacts" class="btn-primary"
                            invisible="not barcode"/>
                </header>
                <sheet>
                    <field name="image_url" widget="image_url" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nom de l'aliment"/></h1>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="barcode" default_focus="1"/>
                            <field name="brand"/>
                        </group>
                        <group string="Classification">
                            <field name="nutriscore_grade"/>
                            <field name="nova_group"/>
                        </group>
                    </group>
                    <group string="Valeurs nutritionnelles (pour 100 g)">
                        <group>
                            <field name="energy_kcal"/>
                            <field name="proteins"/>
                            <field name="carbohydrates"/>
                            <field name="sugars"/>
                        </group>
                        <group>
                            <field name="fat"/>
                            <field name="saturated_fat"/>
                            <field name="fiber"/>
                            <field name="salt"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_nutrition_food_search" model="ir.ui.view">
        <field name="name">nutrition.food.search</field>
        <field name="model">nutrition.food</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="barcode"/>
                <field name="brand"/>
                <field name="nutriscore_grade"/>
                <field name="nova_group"/>
                <group>
                    <filter name="group_nutriscore" string="Nutri-Score"
                            context="{'group_by': 'nutriscore_grade'}"/>
                    <filter name="group_nova" string="Groupe NOVA"
                            context="{'group_by': 'nova_group'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_nutrition_food" model="ir.actions.act_window">
        <field name="name">Aliments</field>
        <field name="res_model">nutrition.food</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>

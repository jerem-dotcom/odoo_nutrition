<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_nutrition_recipe_list" model="ir.ui.view">
        <field name="name">nutrition.recipe.list</field>
        <field name="model">nutrition.recipe</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="energy_kcal"/>
                <field name="proteins"/>
                <field name="carbohydrates"/>
                <field name="fat"/>
            </list>
        </field>
    </record>

    <record id="view_nutrition_recipe_form" model="ir.ui.view">
        <field name="name">nutrition.recipe.form</field>
        <field name="model">nutrition.recipe</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nom de la recette"/></h1>
                    </div>
                    <field name="food_ids">
                        <list>
                            <field name="name"/>
                            <field name="brand"/>
                            <field name="total_quantity"/>
                            <field name="total_unit"/>
                            <field name="energy_kcal"/>
                            <field name="proteins"/>
                            <field name="carbohydrates"/>
                            <field name="fat"/>
                        </list>
                    </field>
                    <group string="Totaux (recette complète)">
                        <group>
                            <field name="energy_kcal"/>
                            <field name="proteins"/>
                            <field name="carbohydrates"/>
                            <field name="sugars"/>
                        </group>
                        <group>
                            <field name="fat"/>
                            <field name="saturated_fat"/>
                            <field name="fiber"/>
                            <field name="salt"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_nutrition_recipe" model="ir.actions.act_window">
        <field name="name">Recettes</field>
        <field name="res_model">nutrition.recipe</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
